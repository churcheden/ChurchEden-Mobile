# ChurchEden Mobile Environment Variables Template
# Copy this file to .env.development, .env.staging, or .env.production

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_URL=https://api.churcheden.app/api/v1
EXPO_PUBLIC_BUNDLE_ID=com.churcheden.app
EXPO_PUBLIC_PACKAGE_NAME=com.churcheden.app

# App Metadata & Feature Flags
EXPO_PUBLIC_ENABLE_QR_SCANNER=true
EXPO_PUBLIC_ENABLE_LIVE_STREAM=true

# Google OAuth
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
# Web/Expo client ID â€” used by the auth proxy (useProxy) ID-token flow in Expo Go.
# This is the SAME client ID registered in Google Cloud under GOOGLE_CLIENT_ID.
# The https://auth.expo.io/@<username>/<slug> redirect URI must be added to this
# Web OAuth client's "Authorized redirect URIs".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Ngrok Auth Token for Expo Tunnel Mode (expo start --tunnel)
NGROK_AUTHTOKEN=your_ngrok_auth_token_here
